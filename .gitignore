# SQLite 数据库（本地开发数据，不入库）
*.db
*.db-journal
*.db-wal
*.db-shm

# 数据库快照（scripts/backup.ps1 的输出：体积大、含本地数据，不入库）
backups/

# Go 编译产物
backend-go/server
backend-go/server.exe
# P0-4 部署时在服务器上编译出来的二进制（生产机专用，不入库）
backend-go/guangxue-api
backend-go/guangxue-backup
backend-rust/guangxue-auth

# Nginx / certbot 改过的站点配置：里面有真实域名，且 certbot 会在续期时自动改写它
#（模板是 deploy/nginx/*.conf.template，那个要入库）
deploy/nginx/*.conf

# Rust 编译产物（任何 crate 的 target/ 都算，含账号服务与 wasm 引擎）
# ⚠️ 这些是可再生的调试/增量缓存，两个 crate 加起来能到 4.5 GB，永不入库
**/target/

# wasm-bindgen 生成的 JS 胶水（由 engine 重新构建生成）
modules/english/engine/pkg/

# 本地密钥 / 环境变量（可能含 JWT 密钥与 SMTP 授权码，永不入库）
.env
backend-rust/.env
backend-go/.env

# 操作系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# 存档备份（只读，永不提交）
备份/

# DSH 插件的运行态目录（本机 GUI 状态，与项目代码无关，不入库）
.dshwolf/

# 跑测试用的临时目录：本机的命令沙箱只允许写工作区内，
# 所以 cargo test / go test 的 TEMP 会指到这里（见 docs/boundaries.md 第 6 节）
.tmp-cargo/
.tmp-test/
.tmp-e2e/
