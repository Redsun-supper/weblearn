            { text: '核心线索', textStyle: { bold: true, color: '#FFFFFF', fontSize: 14 }, cellStyle: { background: { color: '#0E3F8C' } } },
          ],
          [
            { text: '实数与代数式', cellStyle: { background: { color: '#FDF3E7' } }, textStyle: { bold: true } },
            { text: '复数、不等式', cellStyle: { background: { color: '#FDF3E7' } } },
            { text: '数系的两次扩张：实数 → 复数', cellStyle: { background: { color: '#FDF3E7' } } },
          ],
          [
            { text: '一元二次方程', cellStyle: { background: { color: '#FDF3E7' } }, textStyle: { bold: true } },
            { text: '一元二次不等式、二次函数', cellStyle: { background: { color: '#FDF3E7' } } },
            { text: '「三个二次」在函数观点下统一', cellStyle: { background: { color: '#FDF3E7' } } },
          ],
          [
            { text: '一次/二次/反比例函数', textStyle: { bold: true } },
            { text: '三角函数、指数对数函数、幂函数' },
            { text: '函数观点成为高中数学纲领' },
          ],
          [
            { text: '平面几何（全等、相似）', cellStyle: { background: { color: '#F0F5FC' } }, textStyle: { bold: true } },
            { text: '立体几何、解析几何、向量几何', cellStyle: { background: { color: '#F0F5FC' } } },
            { text: '综合几何 → 向量/坐标方法', cellStyle: { background: { color: '#F0F5FC' } } },
          ],
          [
            { text: '三角形与解直角三角形', textStyle: { bold: true } },
            { text: '正弦定理余弦定理、三角函数' },
            { text: '从直角走向一般三角形' },
          ],
          [
            { text: '数据的分析、古典概型', cellStyle: { background: { color: '#F0F5FC' } }, textStyle: { bold: true } },
            { text: '随机变量及其分布、统计推断', cellStyle: { background: { color: '#F0F5FC' } } },
