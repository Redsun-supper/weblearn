<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: '0' }}>
  <Box style={{ width: '100%', height: 88, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FFFFFF' }}>必修与选择性必修的课程地图</Text>
    <Text style={{ fontSize: 15, color: '#9DB8E0' }}>03 高中 · 课程结构与四大主题</Text>
  </Box>
  <Box style={{ width: '100%', height: 572, flexDirection: 'row', padding: '20px 40px', gap: 24 }}>
    <Box style={{ width: 280, height: '100%', flexDirection: 'column', gap: 14 }}>
      <Box style={{ background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 12, padding: '20px 22px', flexDirection: 'column', gap: 10, flex: 1 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>两级课程</Text>
        <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.8 }}><span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>必修</span>：两册，面向全体学生，奠定共同基础。</Text>
        <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.8 }}><span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>选择性必修</span>：三册，在必修基础上加深拓广，供升学选择。</Text>
        <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.7 }}>五册共同构成「一主线、两翼、一工具箱」的完整结构。</Text>
      </Box>
      <Box style={{ background: '#0E3F8C', borderRadius: 10, padding: '14px 22px' }}>
        <Text style={{ fontSize: 15, color: '#FFFFFF', lineHeight: 1.6 }}>判断：函数在必修第一册即登场，并一路走到选择性必修第二册的导数——主线地位从课表即可读出。</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, height: '100%', background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 12, padding: 16 }}>
      <Table
        style={{ width: '100%', height: '100%' }}
        defaultTextStyle={{ fontSize: 15, textAlign: 'left', color: '#1A2230' }}
        defaultCellStyle={{
          padding: 10,
          border: {
            left: { width: 1, color: '#E5E7EB' },
            right: { width: 1, color: '#E5E7EB' },
            top: { width: 1, color: '#E5E7EB' },
            bottom: { width: 1, color: '#E5E7EB' },
          },
        }}
        cells={[
          [
            { text: '类别', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
            { text: '册别', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
            { text: '覆盖主题', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
          ],
          [
            { text: '必修', cellStyle: { background: { color: '#F0F5FC' } }, textStyle: { bold: true, color: '#1E4FA8' } },
            { text: '第一册', cellStyle: { background: { color: '#F0F5FC' } } },
            { text: '预备知识（集合与逻辑、不等式）· 函数（概念性质、指对、三角、应用）', cellStyle: { background: { color: '#F0F5FC' } } },
          ],
          [
            { text: '必修', textStyle: { bold: true, color: '#1E4FA8' } },
            { text: '第二册' },
            { text: '几何与代数（向量、复数、立体几何初步）· 统计与概率' },
          ],
          [
            { text: '选择性必修', cellStyle: { background: { color: '#F0F5FC' } }, textStyle: { bold: true, color: '#1E4FA8' } },
            { text: '第一册', cellStyle: { background: { color: '#F0F5FC' } } },
            { text: '空间向量与立体几何 · 解析几何（直线与圆、圆锥曲线）', cellStyle: { background: { color: '#F0F5FC' } } },
          ],
          [
            { text: '选择性必修', textStyle: { bold: true, color: '#1E4FA8' } },
            { text: '第二册' },
            { text: '函数主线延续：数列 · 导数及其应用' },
          ],
          [
            { text: '选择性必修', cellStyle: { background: { color: '#F0F5FC' } }, textStyle: { bold: true, color: '#1E4FA8' } },
            { text: '第三册', cellStyle: { background: { color: '#F0F5FC' } } },
            { text: '计数原理 · 随机变量及其分布 · 成对数据的统计分析', cellStyle: { background: { color: '#F0F5FC' } } },
          ],
        ]}
      />
    </Box>
  </Box>
  <Box style={{ width: '100%', height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px', borderTop: '1px solid #E5E7EB' }}>
    <Text style={{ fontSize: 13, color: '#8B97A8' }}>依据《普通高中数学课程标准（2017 年版 2020 年修订）》整理</Text>
    <Text style={{ fontSize: 15, color: '#0E3F8C' }}>10 / 15</Text>
  </Box>
</Slide>
