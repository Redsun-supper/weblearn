<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: '0' }}>
  <Box style={{ width: '100%', height: '100%', flexDirection: 'row' }}>
    <Box style={{ width: 400, height: '100%', background: '#0E3F8C', padding: '64px 48px', flexDirection: 'column', justifyContent: 'space-between' }}>
      <Box style={{ flexDirection: 'column', gap: 12 }}>
        <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#FFFFFF', letterSpacing: 4 }}>目录</Text>
        <Text style={{ fontSize: 16, color: '#9DB8E0', letterSpacing: 3 }}>CONTENTS</Text>
        <Box style={{ width: 48, height: 3, background: '#3D7BD9', marginTop: 8 }} />
      </Box>
      <Text style={{ fontSize: 15, color: '#9DB8E0', lineHeight: 1.8 }}>从全景到分支，<br />从初中到高中，<br />用一条主线把六年课程串起来。</Text>
    </Box>
    <Box style={{ flex: 1, height: '100%', padding: '72px 64px', flexDirection: 'column', justifyContent: 'center', gap: 28 }}>
      {[
        { no: '01', title: '全景与主线', desc: '一张图看懂中学数学：三条暗线与一条纲领' },
        { no: '02', title: '初中 · 三大领域', desc: '数与代数 / 图形与几何 / 统计与概率，10 个分支' },
        { no: '03', title: '高中 · 课程结构与四大主题', desc: '必修与选择性必修地图，函数主线与其余三主题' },
        { no: '04', title: '衔接与展望', desc: '七条初高中衔接线索，看见知识的生长点' },
      ].map((it, idx) => (
        <Box key={idx} style={{ flexDirection: 'row', alignItems: 'center', gap: 24, padding: '20px 24px', background: idx % 2 === 0 ? '#F7F9FC' : '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 8 }}>
          <Box style={{ width: 56, height: 56, background: '#1E4FA8', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>{it.no}</Text>
          </Box>
          <Box style={{ flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#0E3F8C' }}>{it.title}</Text>
            <Text style={{ fontSize: 15, color: '#4A5568' }}>{it.desc}</Text>
          </Box>
        </Box>
      ))}
    </Box>
  </Box>
</Slide>
