<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: '0' }}>
  <Box style={{ width: '100%', height: 88, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FFFFFF' }}>图形与几何：从直观到推理</Text>
    <Text style={{ fontSize: 15, color: '#9DB8E0' }}>02 初中 · 三大领域</Text>
  </Box>
  <Box style={{ width: '100%', height: 572, flexDirection: 'row', padding: '20px 40px', gap: 24 }}>
    <Box style={{ width: 700, height: '100%', flexDirection: 'row', flexWrap: 'wrap', gap: 16, alignContent: 'stretch' }}>
      {[
        { t: '图形性质', d: '相交线与平行线、三角形、全等、勾股定理、平行四边形、圆、相似——初中几何的主体。', k: '命题与证明 · 辅助线 · 圆周角定理 · 相似比' },
        { t: '图形变化', d: '平移、旋转、轴对称与中心对称、投影与三视图——从静态性质扩展到运动与变换。', k: '全等变换 · 对称性 · 三视图' },
        { t: '图形与坐标', d: '平面直角坐标系、用坐标表示位置与运动——数形结合的第一次正式握手。', k: '坐标平面 · 坐标与变换' },
        { t: '尺规作图', d: '五种基本作图：等线段、等角、角平分线、垂直平分线、垂线——从画图到按规则构造。', k: '基本作图 · 作图依据' },
      ].map((b, i) => (
        <Box key={i} style={{ width: 342, height: 258, background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 12, padding: '18px 20px', flexDirection: 'column', gap: 10 }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 28, height: 28, background: '#1E4FA8', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>{'0' + (i + 1)}</Text>
            </Box>
            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>{b.t}</Text>
          </Box>
          <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.7 }}>{b.d}</Text>
          <Text style={{ fontSize: 13, color: '#1E4FA8', marginTop: 'auto' }}>{b.k}</Text>
        </Box>
      ))}
    </Box>
    <Box style={{ flex: 1, height: '100%', flexDirection: 'column', gap: 16 }}>
      <Box style={{ background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 12, padding: '20px 22px', flexDirection: 'column', gap: 10, flex: 1 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>推理三级跳</Text>
        <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.9 }}>直观感知<span style={{ color: '#3D7BD9' }}> → </span>合情推理<span style={{ color: '#3D7BD9' }}> → </span>演绎推理</Text>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.8 }}>全等与相似训练的不只是图形知识，而是「从已知到求证」的严谨链条——这正是高中向量方法与坐标方法的地基。</Text>
        <Box style={{ flexDirection: 'row', gap: 8, flexWrap: 'wrap', marginTop: 4 }}>
          {['演绎推理', '几何直观', '空间观念'].map((c, i) => (
            <Box key={i} style={{ background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 999, padding: '4px 12px' }}>
              <Text style={{ fontSize: 13, color: '#1E4FA8' }}>{c}</Text>
            </Box>
          ))}
        </Box>
      </Box>
      <Box style={{ background: '#0E3F8C', borderRadius: 10, padding: '14px 22px' }}>
        <Text style={{ fontSize: 15, color: '#FFFFFF', lineHeight: 1.6 }}>判断：初中平面几何的证明训练，决定高中立体几何与解析几何的起点高度。</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ width: '100%', height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px', borderTop: '1px solid #E5E7EB' }}>
    <Text style={{ fontSize: 13, color: '#8B97A8' }}>依据《义务教育数学课程标准（2022 年版）》整理</Text>
    <Text style={{ fontSize: 15, color: '#0E3F8C' }}>07 / 15</Text>
  </Box>
</Slide>
