# 广学账号系统 · 环境变量示例
#
# 用法：复制成 .env（已在 .gitignore 里），服务启动时会自动加载（dotenvy）。
# 也可以不用 .env，直接在 shell 里设环境变量。
#
# ⚠️ APP_ENV=production 时：AUTH_JWT_SECRET 必须显式提供，且不允许使用默认管理员口令。

# ---- 基础 ----
APP_ENV=development
AUTH_HOST=127.0.0.1
AUTH_PORT=8081
AUTH_DB_PATH=auth.db

# ---- 密钥（生产必须自己生成一串足够长的随机值）----
# AUTH_JWT_SECRET=请替换为随机字符串
# AUTH_CODE_PEPPER=不填则复用 AUTH_JWT_SECRET

# ---- 会话有效期 ----
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30

# ---- Cookie ----
# production 自动为 true；本地 http 调试必须为 false，否则 Cookie 不落地
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_DOMAIN=
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8899,http://localhost:8899

# ---- 邮件（log = 只打日志并发到 dev 接口；smtp = 真发信）----
#
# 从 log 换成 smtp 的检查清单（P0-3）：
#   ① 授权码是**邮箱设置里生成**的那串（QQ 邮箱：设置 → 账号 → POP3/SMTP 服务），不是登录密码；
#   ② 端口与加密方式要配套：465 配 implicit、587 配 starttls、25 配 none；
#   ③ 发件人一般必须**与登录账号同一个邮箱**，否则会被拒；
#   ④ 带空格 / 带尖括号的发件人**必须加双引号** —— 不加引号时 dotenvy 会把整行丢掉
#      且不报错，发件人会静默退化成登录账号（有测试钉着这条行为）；
#   ⑤ 改完用 `cargo run --bin mail-test -- 你的邮箱@example.com` 真发一封验收，
#      它读的是同一份配置；服务启动时也会打印一行 SMTP 自检（只连 TCP，不登录）。
#   ⑥ ⚠️ 换成 smtp 之后验证码**只走邮件**，不再写日志、dev 接口也拿不到了。
#   ⑦ 上线还要做 SPF / DKIM / DMARC，否则大概率进垃圾箱（见 docs/launch-plan.md P0-3）。
AUTH_MAIL_MODE=log
# AUTH_SMTP_HOST=smtp.qq.com
# AUTH_SMTP_PORT=465
# AUTH_SMTP_USERNAME=2262997289@qq.com
# AUTH_SMTP_PASSWORD=邮箱设置里生成的 SMTP 授权码（不是登录密码）
# 不填则用 AUTH_SMTP_USERNAME；带显示名要加引号
# AUTH_SMTP_FROM="广学 <2262997289@qq.com>"
# tls（= implicit，465 用，不填就是它）/ starttls（587 用）/ none（25 用）
# AUTH_SMTP_TLS=implicit
# AUTH_SMTP_TIMEOUT_SECONDS=15

# ---- 开发调试接口（仅 development 生效；生产路由根本不注册）----
# AUTH_DEV_ENDPOINTS=true

# ---- 注册门槛：强制邀请码（P0-2）----
# true  = 没有有效邀请码就**发不出验证码**（连 email_codes 都不写库），上传前必须打开
# false = 开放注册（本地开发默认，方便随手建账号）
# ⚠️ 默认值是 false，**生产必须显式写成 true** —— 刻意不做成「生产自动开启」，
#    否则「忘了配」和「故意关掉」在配置里长得一模一样。
AUTH_REQUIRE_INVITE=false

# ---- 初始管理员（仅 development 允许用默认口令）----
AUTH_ADMIN_EMAIL=2262997289@qq.com
AUTH_ADMIN_PASSWORD=7289HR_RedSun
AUTH_SEED_ADMIN=true

# ---- 口令哈希参数（默认即 OWASP 推荐值；调小只适合本地压测）----
# AUTH_ARGON2_M_COST=19456
# AUTH_ARGON2_T_COST=2
# AUTH_ARGON2_P_COST=1

# ---- 限流与锁定（P2：AUTH_RL_* 这一组从 2026-10 起**真的生效**了）----
#
# 格式是 `次数/窗口秒`：`200/900` = 15 分钟内最多 200 次。`0/0` 关闭这条规则
# （**任一侧**写 0 都算关闭，所以 `0/60` 也行 —— 写它的人想表达的是「别限了」）。
# ⚠️ 格式写错会**拒绝启动**并点名配置项，不会静默退回默认值：静默退回的症状是
#    「明明放宽了却还被 429」，而配置文件看上去完全正常，那种问题最难查。
#
# 口径是「**严在账号、宽在 IP**」：IP 是共享资源（校园 / 公司 / 运营商 CGNAT 出口后面
# 可能站着几十上百人），账号才是身份。所以账号维度卡死、IP 维度放宽。
# 下面列的是**默认值**（不配就是这些），写出来是为了让人知道该往哪个方向调。
#
# ⚠️ 这些限流是**单进程内存**实现：进程重启即清零，多开实例各算一份。
#    粗粒度洪水另有一层在 Nginx（单 IP 30 次/分的账号接口，见
#    deploy/nginx/guangxue.conf.template），两层都回 429。
# AUTH_RL_LOGIN_IP=200/900            # 登录：同 IP 15 分钟 200 次
# AUTH_RL_CODE_EMAIL_MINUTE=1/60      # 发验证码：同邮箱 1 分钟 1 次
# AUTH_RL_CODE_EMAIL_HOUR=5/3600      # 发验证码：同邮箱 1 小时 5 次
# AUTH_RL_CODE_IP=200/3600            # 发验证码：同 IP 1 小时 200 次
# AUTH_RL_REGISTER_IP=100/3600        # 注册：同 IP 1 小时 100 次
# AUTH_LOCK_THRESHOLD=5               # 密码连续错几次锁账号（账号维度，不在 AUTH_RL_* 里）
# AUTH_LOCK_MINUTES=15                # 锁多久

# ---- 探活与告警（guangxue-monitor，P2）----
#
# 这一组**通常不写在这里**：它们由 deploy/systemd/guangxue-monitor.service 的
# `Environment=` 提供（那个 unit 用 `EnvironmentFile=` 读的正是本文件，所以写在这里也认）。
# 要改推荐 `sudo systemctl edit guangxue-monitor.service` 写一个 drop-in，
# 改完按 docs/deploy-runbook.md 第 9 节做一次
# 「停账号服务 → 收到告警 → 起回来 → 收到恢复」的演练。
#
# ⚠️ MONITOR_ALERT_TO 留空 = 告警**只写日志、不发信**（脚本会打印一行提示）。
# ⚠️ 告警邮件走的就是上面那套 AUTH_MAIL_MODE / AUTH_SMTP_*：`AUTH_MAIL_MODE=log` 时
#    告警同样发不出去 —— 「告警能真的发出来」与「注册能收到验证码」是同一个前提。
# MONITOR_ALERT_TO=你的邮箱@example.com     # 留空 = 只写日志
# MONITOR_REPEAT_HOURS=6                   # 持续故障每 6 小时重发一次；0 = 只在状态变化时发
# MONITOR_GO_URL=http://127.0.0.1:8080/api/health?deep=1         # 默认值，一般不用改
# MONITOR_AUTH_URL=http://127.0.0.1:8081/api/auth/health?deep=1  # 默认值，一般不用改
# MONITOR_STATE_FILE=/var/lib/guangxue-monitor/state.json        # 默认值；目录由 unit 的 StateDirectory= 建好
# MONITOR_TIMEOUT_SECONDS=5                                      # 单次探活请求超时
