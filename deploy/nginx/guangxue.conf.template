# ============================================================================
# 广学 · Nginx 站点配置（P0-4 公网部署）
#
# 这是**模板**：把 @DOMAIN@ 换成你的域名后再交给 Nginx（runbook 里有一条 Replace 命令）。
# 也可以直接改 deploy/nginx/guangxue.conf —— 那个文件已经被 .gitignore 排除，
# 因为 certbot 会往里写它自己的续期配置。
#
# 分流规则（与账号服务的监听端口一一对应，别改错）：
#   /api/auth/*  → 127.0.0.1:8081  Rust 账号服务
#   /api/*       → 127.0.0.1:8080  Go 主后端
#   其余         → 仓库根目录的静态文件
#
# ⚠️ 三个坑（都真实发生过，别再踩一遍）：
#   ① `proxy_pass` 末尾**不要带 `/`**：带了会把 /api/xxx 改写成 /xxx，全线 404；
#   ② `/api/auth/` 必须写在 `/api/` **前面**：Nginx 前缀匹配是「最长优先」没错，
#      但两个 location 写反了之后，以后有人来加规则时极容易改错，顺序即文档；
#   ③ `X-Forwarded-For` 必须由我们**覆盖**成 $remote_addr，不能追加（P2 修的真漏洞）：
#      伪造 XFF 就能绕开账号服务里所有按 IP 的限流，理由见下面两处 location 的注释。
# ============================================================================

# ============================================================================
# 限流（P2）
#
# ⚠️ 这五行**必须写在 http 上下文**，也就是任何 `server {}` 块**外面**（写在本文件顶部
#    正好满足：本文件是被 nginx.conf 的 `http {}` 里 include 进来的）。
#    写进 `server {}` 里 `sudo nginx -t` 会直接报错：
#      "limit_req_zone" directive is not allowed here
#
# 三层防守各管各的（排查某个「被限流了」时按①→②→③的顺序想）：
#   ① **账号维度**在 Rust 进程里（backend-rust/src/rate_limit.rs）：同邮箱发码 1 次/分、
#      5 次/时；密码连续错 5 次锁 15 分钟 —— 这几条最严，也最不能放松；
#   ② **IP 维度**也在应用里（`AUTH_RL_*`，见 backend-rust/.env.example），但**故意放宽**
#      （200/900 这种量级）：IP 是共享资源，校园 / 公司 / 运营商 CGNAT 出口后面可能站着
#      几十上百人，按「一个人一台机器」算额度会让整栋楼在早高峰一起收到 429；
#   ③ **粗粒度洪水**交给这里：单个 IP 的脚本/爬虫/撞库在 Nginx 就被挡住，不进应用。
#      30r/m 对正常人类操作绰绰有余，对脚本是硬墙。
#
# ⚠️ 两层都回 **429**。区分方法：先看 Nginx access log 里有没有 429 ——
#    有 → 是这一层（同一个 IP 整体被限）；没有 → 是应用里的账号维度，
#    响应体里会带一句中文 message，`journalctl -u guangxue-auth` 里也有记录。
#
# `limit_conn` 防的是「一个 IP 同时挂住几十条慢连接」；`limit_req` 的 burst/nodelay
# 允许短时突发（开一个页面同时打几个接口很正常），超出的直接 429、**不排队** ——
# 排队会把正常用户的请求一起拖慢，还会占着 worker 连接。
# ============================================================================
limit_req_zone $binary_remote_addr zone=gx_auth:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=gx_api:10m  rate=300r/m;
limit_conn_zone $binary_remote_addr zone=gx_conn:10m;
limit_req_status 429;
limit_conn_status 429;

# HTTP：只做两件事 —— 给 certbot 的验证留个口子，其余一律跳 HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name @DOMAIN@;

    # certbot 的 webroot 验证：**必须放在跳转之前**，否则续期会失败
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @DOMAIN@;

    # ---- 证书（certbot 会自动填这两行，见 runbook 第 5 步）----
    ssl_certificate     /etc/letsencrypt/live/@DOMAIN@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@DOMAIN@/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS：先别加 includeSubDomains 与 preload —— 它们没法快速回滚。
    # 确认整站（含所有子域）都上 HTTPS 之后，再改成
    #   max-age=31536000; includeSubDomains
    add_header Strict-Transport-Security "max-age=300" always;

    # 站点自己不用被 iframe 套（后台/前台都没有这个需求）
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 静态站是纯静态的：文件就放在这个目录（runbook 里用 rsync 推上去）
    root /var/www/guangxue;
    index index.html;
    charset utf-8;

    # 上传/接口体积：本项目没有文件上传，16m 只是给后台导词条留的余量
    client_max_body_size 16m;

    # 访问日志交给 journald 之外的普通文件；⚠️ 这两个文件里**不能出现**
    # 验证码明文与密码 —— 验证码只在响应体里回给用户，请求体里的密码走 POST body，
    # 默认的 combined 格式不记录 body，所以是安全的。
    access_log /var/log/nginx/guangxue.access.log;
    error_log  /var/log/nginx/guangxue.error.log warn;

    # ---- 1) 账号服务（Rust）——⚠️ 必须写在 /api/ 之前 ----
    location /api/auth/ {
        # ⚠️ 末尾不带 `/`：带了就会把 /api/auth/me 改写成 /me
        proxy_pass http://127.0.0.1:8081;

        # Nginx 这一层的粗粒度限流（zone 定义在文件顶部，只能在 http 上下文里定义）。
        # 账号接口最敏感：单 IP 30 次/分、突发最多 20 条（burst=20 + nodelay，超出的直接 429）；
        # 并发连接最多 20 条。
        limit_req zone=gx_auth burst=20 nodelay;
        limit_conn gx_conn 20;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # ⚠️ XFF 必须是 $remote_addr，**不能**用 $proxy_add_x_forwarded_for（P2 修的真漏洞）：
        # 后者 = 「客户端自己发来的 XFF」+ $remote_addr，客户端伪造的那段会留在**最前面**；
        # 而 backend-rust/src/http/middleware.rs 的 client_ip() 取的是 XFF 的**第一个**值 ——
        # 于是随手伪造一个 X-Forwarded-For 就能绕开账号服务里**所有**按 IP 的限流
        # （登录、发码、注册，那正是撞库与邮件滥用的防线）。
        # 我们是单层代理，$remote_addr 才是权威值：由我们**覆盖**掉客户端给的值。
        #
        # 将来若在前面加了 CDN / 负载均衡：改用 realip 模块（ngx_http_realip_module）
        #   set_real_ip_from <CDN 回源网段>;
        #   real_ip_header X-Forwarded-For;
        #   real_ip_recursive on;
        # 只在**可信来源**的地址上采信 XFF，别无脑信任它；
        # realip 生效后 $remote_addr 已经是真实客户端 IP，这一行不用再改。
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie            $http_cookie;
        proxy_read_timeout 30s;
    }

    # ---- 2) 主后端（Go）----
    location /api/ {
        proxy_pass http://127.0.0.1:8080;

        # 单 IP 300 次/分、突发最多 100 条、并发连接最多 30 条。
        # 比账号接口宽松：打开一个页面会同时打几个接口，管太紧会把正常用户打成 429。
        limit_req zone=gx_api burst=100 nodelay;
        limit_conn gx_conn 30;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # ⚠️ 同 /api/auth/：XFF 覆盖成 $remote_addr（理由与 CDN 场景见上面那一处注释）
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie            $http_cookie;
        proxy_read_timeout 30s;
    }

    # ---- 3) 探活（可选）：给运维直接 curl 用，不必翻两个服务的日志 ----
    location = /healthz {
        default_type "text/plain";
        return 200 "ok\n";
    }

    # ---- 4) 不要把这些文件暴露出去 ----
    # 仓库根目录里有 .env（密钥）、备份包、数据库快照……静态根指向仓库时它们是**真实可达**的。
    # 下面这几条是兜底：真上线时请按 runbook 用 rsync 白名单只推前端文件，别整仓库推。
    location ~ /\.(?!well-known) {
        deny all;
    }
    location ~* \.(env|db|db-wal|db-shm|sqlite3?|zip|log|md|toml|yaml|yml|lock)$ {
        deny all;
    }
    location ~ ^/(backend-go|backend-rust|scripts|docs|deploy)/ {
        deny all;
    }

    # ---- 5) 静态文件 ----
    location / {
        # 目录 URL（/account/）内部补 index.html，但**不改变浏览器地址**。
        # 不要用 index 指令完成这件事：那次内部跳转会变成一次 301，
        # 把 /account/ 变成 /account/index.html（前端里的相对路径就全变了）。
        try_files $uri $uri/index.html $uri/ =404;
    }

    # HTML 不缓存（改完立刻生效），带指纹的静态资源可以长缓存。
    # ⚠️ 本项目文件名没有指纹，所以 js/css 也走「协商缓存」而不是长缓存，
    #    否则改了样式用户要等缓存过期才看到。
    location ~* \.(html|js|css)$ {
        add_header Cache-Control "no-cache";
    }

    location ~* \.(png|jpe?g|gif|svg|webp|ico|woff2?|ttf)$ {
        add_header Cache-Control "public, max-age=604800";
    }
}
